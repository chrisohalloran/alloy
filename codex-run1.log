defmodule Alloy.Test.EchoTool do
  @moduledoc false
  @behaviour Alloy.Tool

  @impl true
  def name, do: "echo"

  @impl true
  def description, do: "Echoes input back"

  @impl true
  def input_schema do
    %{type: "object", properties: %{text: %{type: "string"}}, required: ["text"]}
  end

  @impl true
  def execute(%{"text" => text}, _context), do: {:ok, "Echo: #{text}"}
  def execute(%{text: text}, _context), do: {:ok, "Echo: #{text}"}

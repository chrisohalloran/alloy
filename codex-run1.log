          timeout_ms: pos_integer(),
          tool_timeout: pos_integer(),
          middleware: [module()],
          compaction: compaction(),
          compaction_explicit: %{
            reserve_tokens: boolean(),
            keep_recent_tokens: boolean()
          },
          working_directory: String.t(),
          context: map(),

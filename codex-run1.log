+
+      started_at = System.monotonic_time(:millisecond)
+      result = Codex.complete([Message.user("deadline")], [], config)
+      elapsed = System.monotonic_time(:millisecond) - started_at
+
+      assert {:error, "codex exec timed out after 150ms"} = result

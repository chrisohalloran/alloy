+        {message_index, block_index}
+      end)
+      |> MapSet.new()
+
+    {cleared_messages, cleared} =
+      messages
+      |> Enum.with_index()
+      |> Enum.map_reduce(%{results_cleared: 0, chars_cleared: 0}, fn {message, message_index},
+                                                                     acc ->
+        if MapSet.member?(old_indexes, message_index) and message_index < protected_from_index do
+          clear_tool_results_in_message(message, message_index, keep_positions, acc)
+        else

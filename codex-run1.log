+    |> Enum.filter(fn {name, _value} -> String.downcase(name) == "anthropic-beta" end)
+    |> Enum.flat_map(fn {_name, value} -> String.split(value, ",", trim: true) end)
+    |> Enum.map(&String.trim/1)
+    |> Enum.sort()
+  end

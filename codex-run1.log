+      else
+        []
+      end
+    end
+  end
+
+  defp old_message_indexes(_, _keep_recent_tokens), do: []
+
+  defp last_real_user_index(messages) do
+    messages
+    |> Enum.with_index()
+    |> Enum.reverse()
+    |> Enum.find_value(-1, fn
+      {%Message{role: :user} = message, index} ->
+        if real_user_message?(message), do: index, else: nil
+
+      _ ->
+        nil
+    end)
+  end
+
+  defp tool_result_positions(messages) do
+    messages
+    |> Enum.with_index()
+    |> Enum.flat_map(fn
+      {%Message{content: blocks}, message_index} when is_list(blocks) ->
+        blocks
+        |> Enum.with_index()
+        |> Enum.flat_map(fn
+          {%{type: type} = block, block_index}
+          when type in ["tool_result", "server_tool_result"] ->
+            [%{message_index: message_index, block_index: block_index, chars: content_chars(block)}]

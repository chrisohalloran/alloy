+      assert advanced_def.defer_loading == true
+
+      basic_def = Enum.find(defs, &(&1.name == "basic"))
+      refute Map.has_key?(basic_def, :input_examples)
+      refute Map.has_key?(basic_def, :defer_loading)
+    end
   end
 end


+        assert_received {:compaction_event, [:alloy, :compaction, :cleared], cleared_turn}
+        assert_received {:compaction_event, [:alloy, :compaction, :done], done_turn}
+        assert cleared_turn == done_turn
+      after
+        :telemetry.detach(handler_id)
+      end
+    end
   end
 

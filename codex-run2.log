+  defp add_cache_to_last_cacheable_block(blocks) do
+    {blocks, _added?} =
+      blocks
+      |> Enum.reverse()
+      |> Enum.map_reduce(false, fn
+        block, false ->
+          if cacheable_message_block?(block) do
+            {Map.put(block, "cache_control", %{"type" => "ephemeral"}), true}
